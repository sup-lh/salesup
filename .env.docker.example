# Docker local infrastructure only. Do not use these defaults in production.
POSTGRES_DB=newcomer
POSTGRES_USER=newcomer
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-local-env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Used later by the independent NestJS API.
DATABASE_URL=postgresql://newcomer:change-me-in-local-env@localhost:5432/newcomer
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=newcomer
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=change-me-in-local-env
NODE_ENV=production
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:8080
