# Docker local development only. Do not use these defaults in production.
POSTGRES_DB=newcomer
POSTGRES_USER=newcomer
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-local-env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Used by the independent NestJS API.
DATABASE_URL=postgresql://newcomer:change-me-in-local-env@localhost:5432/newcomer
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=newcomer
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=change-me-in-local-env
NODE_ENV=development
# Local-only secret. Replace it before any production deployment.
SESSION_SECRET=development-only-session-secret-change-before-production
APP_BASE_URL=http://localhost:8080

# Local administrator and demo accounts. Change these before sharing an environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SalesUp-Admin-2026!
ADMIN_DISPLAY_NAME=系统管理员
DEMO_PASSWORD=Demo-SalesUp-2026!
